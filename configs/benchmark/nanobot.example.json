{
  "nanobot_root": "/path/to/nanobot",
  "python": "/path/to/nanobot/.venv/bin/python",
  "model": "deepseek-chat",
  "sandbox": "docker",
  "docker_base_image": "python:3.11-slim",
  "base_url": "https://api.deepseek.com/v1",
  "api_key_env": "DEEPSEEK_API_KEY",
  "temperature": 0,
  "max_tokens": 2048,
  "max_steps": 12,
  "timeout_seconds": 180,
  "token_limit": 32768,
  "message_limit": 100,
  "variant": "baseline",
  "tokenizer_mode": "cl100k_base",
  "extra_body": {"thinking": {"type": "disabled"}},
  "instructions": ""
}
