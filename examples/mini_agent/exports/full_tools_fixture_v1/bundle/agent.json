            "type": "string"
          },
          "status": {
            "enum": [
              "READY",
              "NEED_CLARIFICATION",
              "NEED_CONFIRMATION",
              "REJECTED"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "intent",
          "status",
          "next_action",
          "reason"
        ],
        "title": "IntentResult",
        "type": "object"
      },
      "ToolCallRecord": {
