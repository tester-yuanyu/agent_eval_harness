            "type": "integer"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "output": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output"
          },
          "status": {
            "enum": [
              "SUCCESS",
              "FAILED",
              "TIMEOUT"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "call_id",
          "name",
          "arguments",
          "status",
          "output",
          "error",
          "duration_ms"
        ],
        "title": "ToolCallRecord",
        "type": "object"
      }
    },
