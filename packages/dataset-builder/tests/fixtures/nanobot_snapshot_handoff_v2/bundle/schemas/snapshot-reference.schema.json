{
  "$defs": {
    "SnapshotTypeV3": {
      "enum": [
        "agent",
        "module",
        "intent",
        "tool",
        "scope",
        "chain",
        "evidence",
        "boundary"
      ],
      "title": "SnapshotTypeV3",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "minLength": 1,
      "title": "Contract Version",
      "type": "string"
    },
    "path": {
      "minLength": 1,
      "title": "Path",
      "type": "string"
    },
    "snapshot_format_version": {
      "const": "3.0",
      "title": "Snapshot Format Version",
      "type": "string"
    },
    "snapshot_id": {
      "pattern": "^(agent|module|intent|tool|scope|chain|evidence|boundary)\\.[a-z][a-z0-9_]*$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Sha256",
      "type": "string"
    },
    "snapshot_type": {
      "$ref": "#/$defs/SnapshotTypeV3"
    }
  },
  "required": [
    "snapshot_id",
    "snapshot_type",
    "snapshot_format_version",
    "contract_version",
    "snapshot_sha256",
    "path"
  ],
  "title": "SnapshotReferenceV3",
  "type": "object"
}
