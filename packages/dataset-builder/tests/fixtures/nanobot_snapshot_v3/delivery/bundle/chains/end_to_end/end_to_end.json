  "branches": [
    {
      "branch_type": "normal",
      "terminal_condition": "RunResult returned; completed is a runner status, not a business success verdict (refusal/content-filter text can be completed)."
    },
    {
      "branch_type": "returned_error",
      "terminal_condition": "Terminal provider error response yields a RunResult with stop_reason=error; it need not raise."
    },
    {
      "branch_type": "tool_error",
      "terminal_condition": "Unrecovered fatal tool error yields stop_reason=tool_error; recoverable errors may instead continue the model loop."
    },
    {
      "branch_type": "iteration_limit",
      "terminal_condition": "stop_reason=max_iterations; a final no-tools response or fallback may be returned with error=null."
    },
    {
      "branch_type": "empty_response",
      "terminal_condition": "Terminal empty model response after recovery yields stop_reason=empty_final_response and diagnostic content."
    },
    {
      "branch_type": "command_return",
      "terminal_condition": "Handled command skips the remaining normal stages; SDK returns directly from the command response, possibly with stop_reason=null."
    },
    {
      "branch_type": "suppressed_response",
      "terminal_condition": "process_direct may return None; SDK content is then empty, with captured fields retained."
    },
    {
      "branch_type": "raised_exception",
      "terminal_condition": "Uncaught Python exception exits the call; no RunResult required and later normal nodes are not reached."
    },
    {
      "branch_type": "cancelled",
      "terminal_condition": "asyncio.CancelledError propagates; no RunResult or rollback is promised."
    }
  ],
