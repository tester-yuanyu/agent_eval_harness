      "error": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Nullable captured diagnostic text; inspect together with stop_reason and content/history. None does not prove task success or rule out earlier recoverable tool errors. Non-null error can retain an earlier failure after continuation produces a later answer; it is not an exact classification of that final answer.",
        "title": "Error"
      },
      "messages": {
        "description": "Captured runner message list; may be empty for command short-circuits. Not a guaranteed complete external event trace.",
        "items": {
          "additionalProperties": true,
          "type": "object"
        },
        "title": "Messages",
        "type": "array"
      },
      "metadata": {
        "additionalProperties": true,
        "description": "Outbound metadata copied by SDK; arbitrary keys, not a stable business result schema.",
        "title": "Metadata",
        "type": "object"
      },
      "stop_reason": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Captured runner status, nullable when runner hooks did not execute (e.g. command shortcut). completed can include refusal/content-filter text. After injection-driven continuation, an earlier error status may remain alongside recovered final content.",
        "title": "Stop Reason"
      },
      "tools_used": {
        "description": "Authoritative after_run capture lists successful tool events; not a complete list of attempts or failures.",
        "items": {
          "type": "string"
        },
        "title": "Tools Used",
        "type": "array"
      },
      "usage": {
        "additionalProperties": {
          "type": "integer"
        },
        "description": "Captured provider token/accounting values; may be empty.",
        "title": "Usage",
        "type": "object"
      }
    },
    "required": [
      "content"
    ],
    "title": "RunResult",
    "type": "object"
