          },
          "status": {
            "enum": [
              "SUCCESS",
              "FAILED",
              "TIMEOUT"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "call_id",
          "name",
          "arguments",
          "status",
          "output",
          "error",
          "duration_ms"
        ],
