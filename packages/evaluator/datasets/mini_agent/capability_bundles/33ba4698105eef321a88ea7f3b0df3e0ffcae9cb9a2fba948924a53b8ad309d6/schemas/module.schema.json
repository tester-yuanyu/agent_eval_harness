      },
      "title": "Module Refs",
      "type": "array"
    },
    "output_schema": {
      "additionalProperties": true,
      "title": "Output Schema",
      "type": "object"
    },
    "responsibility": {
      "minLength": 1,
      "title": "Responsibility",
      "type": "string"
    },
    "snapshot_format_version": {
      "const": "2.0",
      "title": "Snapshot Format Version",
      "type": "string"
