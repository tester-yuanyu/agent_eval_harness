{
  "$defs": {
    "SnapshotReference": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "minLength": 1,
          "title": "Contract Version",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "snapshot_format_version": {
          "const": "2.0",
          "title": "Snapshot Format Version",
          "type": "string"
        },
        "snapshot_id": {
