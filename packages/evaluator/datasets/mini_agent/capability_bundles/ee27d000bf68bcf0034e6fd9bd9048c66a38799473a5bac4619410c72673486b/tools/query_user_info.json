  "function_schema": {
    "description": "Query fictional users using combined lookup conditions.",
    "name": "query_user_info",
    "parameters": {
      "additionalProperties": false,
      "description": "Lookup a mock user using one or more combined conditions.",
      "properties": {
        "email": {
          "anyOf": [
            {
              "minLength": 3,
              "pattern": "^[^@]+@[^@]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Email"
        },
        "phone": {
          "anyOf": [
            {
              "pattern": "^[0-9]{11}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Phone"
        },
        "room_id": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Room Id"
        },
        "user_id": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "User Id"
        }
      },
      "required": [
        "user_id",
        "room_id",
        "email",
        "phone"
      ],
      "title": "QueryUserInfoArguments",
      "type": "object"
    },
    "strict": true,
    "type": "function"
  },
  "idempotency_rules": {
    "mode": "NOT_APPLICABLE"
  },
  "parameter_rules": {
    "email_format": "EXACTLY_ONE_AT_WITH_NONEMPTY_SIDES",
    "email_output": "MASK_LOCAL_PART",
    "minimum_conditions": 1,
    "multiple_fields": "AND",
    "phone_format": "ASCII_DIGITS_EXACTLY_11",
    "phone_output": "MASK_MIDDLE_FOUR_DIGITS"
  },
  "partial_success_behavior": "UNSUPPORTED",
  "permission_requirements": [
    "REGISTERED_TOOL_AND_RUN_ALLOW_LIST"
  ],
  "rate_limit_behavior": "UNSUPPORTED_NO_SILENT_RETRY",
  "requires_confirmation": false,
  "result_codes": [
