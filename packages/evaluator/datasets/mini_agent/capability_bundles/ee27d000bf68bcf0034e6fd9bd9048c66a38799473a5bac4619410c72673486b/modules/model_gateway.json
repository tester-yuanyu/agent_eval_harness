              "$ref": "#/$defs/FunctionCallOutput"
            },
            "title": "Tool Outputs",
            "type": "array"
          },
          "tool_schemas": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Tool Schemas",
            "type": "array"
          },
          "user_input": {
            "title": "User Input",
            "type": "string"
          }
        },
        "required": [
          "user_input",
          "intent_result",
          "tool_schemas",
          "tool_outputs",
          "step"
        ],
        "title": "ToolLoopRequest",
        "type": "object"
      }
    ]
