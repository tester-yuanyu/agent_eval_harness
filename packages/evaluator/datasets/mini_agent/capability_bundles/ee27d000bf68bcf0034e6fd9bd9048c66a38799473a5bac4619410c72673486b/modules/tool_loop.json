          "name",
          "output"
        ],
        "title": "FunctionCallOutput",
        "type": "object"
      },
      "IntentResult": {
        "additionalProperties": false,
        "description": "Observable result produced by the future intent router.",
        "properties": {
          "intent": {
            "enum": [
              "query_information",
              "prepare_resource",
              "query_user",
              "query_gift",
              "add_backpack_gift",
              "query_pool",
              "unsupported"
            ],
            "title": "Intent",
            "type": "string"
          },
          "missing_parameters": {
            "items": {
              "type": "string"
            },
            "title": "Missing Parameters",
            "type": "array"
          },
          "next_action": {
            "enum": [
              "CALL_TOOL",
              "ASK_USER",
              "ASK_CONFIRMATION",
              "REJECT"
            ],
            "title": "Next Action",
            "type": "string"
          },
          "parameters": {
            "additionalProperties": true,
            "title": "Parameters",
            "type": "object"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "status": {
            "enum": [
              "READY",
              "NEED_CLARIFICATION",
              "NEED_CONFIRMATION",
              "REJECTED"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "intent",
          "status",
          "next_action",
          "reason"
        ],
        "title": "IntentResult",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Complete observable input for one scripted tool-loop model request.",
