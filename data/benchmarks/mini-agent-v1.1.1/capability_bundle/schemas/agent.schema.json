{
  "$defs": {
    "CapabilityClaimV3": {
      "additionalProperties": false,
      "properties": {
        "capability_key": {
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
          "title": "Capability Key",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "support_status": {
          "$ref": "#/$defs/SupportStatusV3"
        }
      },
      "required": [
        "capability_key",
        "support_status",
        "evidence_ids",
        "reason"
      ],
      "title": "CapabilityClaimV3",
      "type": "object"
    },
    "SnapshotReferenceV3": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "minLength": 1,
          "title": "Contract Version",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "snapshot_format_version": {
          "const": "3.0",
          "title": "Snapshot Format Version",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^(agent|module|intent|tool|scope|chain|evidence|boundary)\\.[a-z][a-z0-9_]*$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Sha256",
          "type": "string"
        },
        "snapshot_type": {
          "$ref": "#/$defs/SnapshotTypeV3"
        }
      },
      "required": [
        "snapshot_id",
        "snapshot_type",
        "snapshot_format_version",
        "contract_version",
        "snapshot_sha256",
        "path"
      ],
      "title": "SnapshotReferenceV3",
      "type": "object"
    },
    "SnapshotTypeV3": {
      "enum": [
        "agent",
        "module",
        "intent",
        "tool",
        "scope",
        "chain",
        "evidence",
        "boundary"
      ],
      "title": "SnapshotTypeV3",
      "type": "string"
    },
    "SupportStatusV3": {
      "enum": [
        "supported",
        "unsupported",
        "unknown"
      ],
      "title": "SupportStatusV3",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Agent Id",
      "type": "string"
    },
    "agent_version": {
      "minLength": 1,
      "title": "Agent Version",
      "type": "string"
    },
    "boundary_refs": {
      "items": {
        "$ref": "#/$defs/SnapshotReferenceV3"
      },
      "title": "Boundary Refs",
      "type": "array"
    },
    "capabilities": {
      "items": {
        "$ref": "#/$defs/CapabilityClaimV3"
      },
      "title": "Capabilities",
      "type": "array"
    },
    "capability_bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Capability Bundle Sha256",
      "type": "string"
    },
    "chain_refs": {
      "items": {
        "$ref": "#/$defs/SnapshotReferenceV3"
      },
      "title": "Chain Refs",
      "type": "array"
    },
    "contract_version": {
      "minLength": 1,
      "title": "Contract Version",
      "type": "string"
    },
    "entrypoints": {
      "items": {
        "type": "string"
      },
      "title": "Entrypoints",
      "type": "array"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/SnapshotReferenceV3"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "input_schema": {
      "additionalProperties": true,
      "title": "Input Schema",
      "type": "object"
    },
    "intent_refs": {
      "items": {
        "$ref": "#/$defs/SnapshotReferenceV3"
      },
      "title": "Intent Refs",
      "type": "array"
    },
    "module_refs": {
      "items": {
        "$ref": "#/$defs/SnapshotReferenceV3"
      },
      "title": "Module Refs",
      "type": "array"
    },
    "output_schema": {
      "additionalProperties": true,
      "title": "Output Schema",
      "type": "object"
    },
    "runtime_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Runtime Versions",
      "type": "object"
    },
    "scope_refs": {
      "items": {
        "$ref": "#/$defs/SnapshotReferenceV3"
      },
      "title": "Scope Refs",
      "type": "array"
    },
    "snapshot_format_version": {
      "const": "3.0",
      "title": "Snapshot Format Version",
      "type": "string"
    },
    "snapshot_id": {
      "pattern": "^(agent|module|intent|tool|scope|chain|evidence|boundary)\\.[a-z][a-z0-9_]*$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Sha256",
      "type": "string"
    },
    "snapshot_type": {
      "const": "agent",
      "title": "Snapshot Type",
      "type": "string"
    },
    "source_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "minProperties": 1,
      "title": "Source Hashes",
      "type": "object"
    },
    "tool_refs": {
      "items": {
        "$ref": "#/$defs/SnapshotReferenceV3"
      },
      "title": "Tool Refs",
      "type": "array"
    }
  },
  "required": [
    "snapshot_id",
    "snapshot_type",
    "snapshot_format_version",
    "contract_version",
    "source_hashes",
    "snapshot_sha256",
    "agent_id",
    "agent_version",
    "entrypoints",
    "input_schema",
    "output_schema",
    "capabilities",
    "module_refs",
    "intent_refs",
    "tool_refs",
    "scope_refs",
    "chain_refs",
    "evidence_refs",
    "boundary_refs",
    "runtime_versions",
    "capability_bundle_sha256"
  ],
  "title": "AgentSnapshotV3",
  "type": "object"
}
