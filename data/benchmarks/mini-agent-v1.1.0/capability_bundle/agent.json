            "type": "string"
          },
          "parameters": {
            "additionalProperties": true,
            "title": "Parameters",
            "type": "object"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "status": {
            "enum": [
              "READY",
              "NEED_CLARIFICATION",
              "NEED_CONFIRMATION",
              "REJECTED"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "intent",
          "status",
          "next_action",
          "reason"
        ],
        "title": "IntentResult",
        "type": "object"
      },
      "ToolCallRecord": {
        "additionalProperties": false,
        "description": "Observable terminal record for one tool call.",
        "properties": {
          "arguments": {
            "additionalProperties": true,
            "title": "Arguments",
            "type": "object"
          },
          "call_id": {
            "title": "Call Id",
            "type": "string"
          },
          "duration_ms": {
            "minimum": 0,
            "title": "Duration Ms",
            "type": "integer"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "output": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output"
          },
          "status": {
            "enum": [
              "SUCCESS",
              "FAILED",
              "TIMEOUT"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "call_id",
          "name",
          "arguments",
          "status",
          "output",
          "error",
          "duration_ms"
        ],
        "title": "ToolCallRecord",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Stable result boundary exposed to the future evaluation framework.",
