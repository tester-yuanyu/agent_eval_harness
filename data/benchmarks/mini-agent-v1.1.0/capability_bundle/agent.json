              "type": "string"
            },
            "title": "Missing Parameters",
            "type": "array"
          },
          "next_action": {
            "enum": [
              "CALL_TOOL",
              "ASK_USER",
              "ASK_CONFIRMATION",
              "REJECT"
            ],
