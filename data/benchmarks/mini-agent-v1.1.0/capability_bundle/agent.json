    "$defs": {
      "IntentResult": {
        "additionalProperties": false,
        "description": "Observable result produced by the future intent router.",
        "properties": {
          "intent": {
            "enum": [
              "query_information",
              "prepare_resource",
              "query_user",
              "query_gift",
              "add_backpack_gift",
